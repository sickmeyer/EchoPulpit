{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadArtifacts",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::${ARTIFACTS_BUCKET}/sermons/*"
    },
    {
      "Sid": "FetchAppCode",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${ARTIFACTS_BUCKET}/app/*"
    },
    {
      "Sid": "FetchDeps",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${ARTIFACTS_BUCKET}/deps/*"
    },
    {
      "Sid": "ListKnownPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${ARTIFACTS_BUCKET}",
      "Condition": {
        "StringLike": { "s3:prefix": ["app/*", "sermons/*", "deps/*"] }
      }
    },
    {
      "Sid": "FetchAnthropicKey",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:${REGION}:${ACCOUNT_ID}:secret:echopulpit/anthropic-api-key-*"
    },
    {
      "Sid": "FetchYtdlpCookies",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:${REGION}:${ACCOUNT_ID}:secret:echopulpit/ytdlp-cookies-*"
    },
    {
      "Sid": "UpdateOwnJobStatus",
      "Effect": "Allow",
      "Action": ["dynamodb:UpdateItem", "dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/${TABLE_NAME}"
    },
    {
      "Sid": "ReadOwnTags",
      "Effect": "Allow",
      "Action": "ec2:DescribeTags",
      "Resource": "*"
    },
    {
      "Sid": "SelfTerminate",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/Project": "echopulpit" }
      }
    },
    {
      "Sid": "ShipLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/echopulpit-worker:*"
    }
  ]
}
