{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteMirror",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::${ARTIFACTS_BUCKET}/deps/*"
    },
    {
      "Sid": "OwnLogGroup",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/aws/lambda/echopulpit-ffmpeg-mirror-refresh:*"
    }
  ]
}
