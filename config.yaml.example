youtube:
  # api_key is intentionally NOT stored here. The Poller Lambda reads it from
  # Secrets Manager; this pipeline script only reads YOUTUBE_API_KEY from the
  # environment when it needs it directly (e.g. local/manual runs).
  channel_id: ""       # or set env CHANNEL_ID
  lookback_hours: 48

transcription:
  whisper_model: "medium"   # tiny, base, small, medium, large-v3
  language: "en"
  vad_filter: true
  prefer_captions: true       # try YouTube captions before falling back to Whisper
  min_caption_coverage: 0.75  # fall back to Whisper if captions cover less than this fraction of the video
  caption_langs: ["en", "en-US", "en-GB"]
  # Optional: if your church streams through Subsplash, point this at a
  # Subsplash podcast feed built from the services' media series. Audio is
  # then downloaded from there (matched by title + date) instead of from
  # YouTube, which often blocks cloud servers as bots; yt-dlp remains the
  # fallback. Leave unset for YouTube-only.
  # subsplash_feed_url: "https://podcasts.subsplash.com/xxxxxxx/podcast.rss"
  # subsplash_wait_minutes: 45  # how long to wait for the episode to be published

sermon_extraction:
  min_minutes: 12
  max_fraction_of_total: 0.9
  window_minutes: 12
  drop_threshold_segments: 8

# Optional: services preached in other languages (see deploy/config.worker.yaml).
# languages:
#   es:
#     whisper_language: "es"
#     caption_langs: ["es", "es-419", "es-MX", "es-US"]
#     default_preacher: "Pastor Name"
#     style_guide_path: ""

church:
  timezone: "America/Chicago"   # service dates are shown in this timezone

llm:
  # Article generation uses Claude if ANTHROPIC_API_KEY is set in the
  # environment (fast, no local model load, small per-call cost) and falls
  # back to the local GGUF model below otherwise. On the local path, long
  # transcripts are chunked and summarized first to fit the model's context;
  # Claude's context window is large enough that this is skipped entirely.
  claude_model: "claude-opus-5-5"   # or set env CLAUDE_MODEL; claude-sonnet-5 is ~4x cheaper
  # Pastoral style guide (markdown, plain-language, editable by non-devs --
  # see prompts/style_guide.md) injected into the prompt. Missing/empty is
  # fine, degrades gracefully to just the system prompt's own voice guidance.
  style_guide_path: "prompts/style_guide.md"   # or set env STYLE_GUIDE_PATH
  model_path: ""       # or set env LLM_MODEL_PATH -- only used without ANTHROPIC_API_KEY
  n_ctx: 4096
  temperature: 0.6
  top_p: 0.9
  # Confirmed by testing: 1600 truncated mid-article; 4000 got a full
  # ~1,400-word article_html but still truncated before the trailing fields
  # (HTML tags/entities and the preceding YAML fields eat more of the budget
  # than raw word count suggests). The v2 prompt's 1,800-2,600 word target
  # plus full verbatim KJV blockquotes (not just references) runs longer
  # still, so this needs real headroom -- it's just a ceiling, no cost for
  # headroom not used.
  #
  max_tokens: 16000          # local model only
  # Claude calls: thinking tokens count against this ceiling, and Opus 5.5
  # needed 25-31K output tokens per article at medium effort (16K left
  # some articles with no text at all). Requests are streamed; billing is
  # by tokens actually used.
  claude_max_tokens: 48000
  thinking_effort: "medium"

output:
  dir: "/data/output"

# Note: there is no "watch" mode anymore. This script now always runs a
# single job for one VIDEO_ID and exits (see bootstrap.sh) -- polling for
# new videos is the Poller Lambda's job, not this script's.